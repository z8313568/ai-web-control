{
  "manifest_version": 3,
  "name": "AI Web Control",
  "version": "0.1.0",
  "description": "让 AI 网页（DeepSeek 等）通过本扩展控制本地电脑：执行命令、读写文件、浏览器自动化。内网零外联。",
  "minimum_chrome_version": "116",

  "key": "",

  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "action": {
    "default_title": "AI Web Control"
  },

  "side_panel": {
    "default_path": "sidepanel.html"
  },

  "permissions": [
    "nativeMessaging",
    "sidePanel",
    "storage",
    "tabs",
    "scripting",
    "notifications"
  ],

  "host_permissions": [
    "*://*.deepseek.com/*",
    "*://chat.deepseek.com/*",
    "*://www.deepseek.com/*",
    "*://platform.deepseek.com/*"
  ],

  "optional_host_permissions": ["<all_urls>"],

  "content_scripts": [
    {
      "matches": ["*://*.deepseek.com/*"],
      "js": [
        "content/config.js",
        "content/logger.js",
        "content/protocol.js",
        "content/ui.js",
        "content/adapter.js",
        "content/floating_taskbar.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
